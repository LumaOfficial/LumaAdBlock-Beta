{
  "manifest_version": 3,
  "name": "Luma Ad Blocker",
  "version": "0.1.0",
  "description": "Blocks ads, trackers and cookie walls with Luma's filter rules.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "luma", "enabled": true, "path": "rules.json" }]
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["cosmetic.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Luma" }
}
