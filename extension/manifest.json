{
  "manifest_version": 3,
  "name": "Luma Ad Blocker",
  "version": "1.0.3",
  "description": "Luma — a fast, friendly ad and tracker blocker",
  "author": "Luma Official",
  "minimum_chrome_version": "102",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cosmetic/selectors.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Luma Ad Blocker",
    "default_popup": "app/index.html#/panel"
  },
  "options_ui": {
    "page": "app/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "luma-core",
        "enabled": true,
        "path": "rules/luma-core.json"
      },
      {
        "id": "tracker-shield",
        "enabled": true,
        "path": "rules/tracker-shield.json"
      },
      {
        "id": "annoyance-cleaner",
        "enabled": true,
        "path": "rules/annoyance-cleaner.json"
      },
      {
        "id": "social-widgets",
        "enabled": false,
        "path": "rules/social-widgets.json"
      }
    ]
  }
}
